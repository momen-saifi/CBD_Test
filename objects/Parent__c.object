<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <validationRules>
        <fullName>phone_field_should_not_be_blank</fullName>
        <active>true</active>
        <errorConditionFormula>OR( ISBLANK( Parent_phone_no__c ) ,  NOT( ISNUMBER( Parent_phone_no__c ) ))</errorConditionFormula>
        <errorMessage>phone field should not be blank or alpha.</errorMessage>
    </validationRules>
</CustomObject>
