<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <validationRules>
        <fullName>phone_field_should_not_be_blank_or_alph</fullName>
        <active>true</active>
        <errorConditionFormula>OR( ISBLANK( college_phone_number__c ) ,  ISNULL( college_phone_number__c )  )</errorConditionFormula>
        <errorDisplayField>college_phone_number__c</errorDisplayField>
        <errorMessage>phone field should not be blank or null.</errorMessage>
    </validationRules>
</CustomObject>
